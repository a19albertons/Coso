  m_TableData:
  - m_Id: 11747233792
    m_Localized: 'Hello, Cosa. How are you? '
    m_Metadata:
      m_Items: []
  - m_Id: 14989430784
    m_Localized: I'm doing well. I see that you've finished the tests.
    m_Metadata:
      m_Items: []
  - m_Id: 17434710016
    m_Localized: Can you advance one block?
    m_Metadata:
      m_Items: []
  - m_Id: 19531862016
    m_Localized: 'Yes, but I''d rather advance two blocks.  '
    m_Metadata:
      m_Items: []
  - m_Id: 22132330496
    m_Localized: I've seen the rock.
    m_Metadata:
      m_Items: []
  - m_Id: 24598581248
    m_Localized: I see that you've learned and haven't had to repeat any test.
    m_Metadata:
      m_Items: []
  - m_Id: 29690466304
    m_Localized: Let's go this way to discuss all the wedding preparations.
    m_Metadata:
      m_Items: []

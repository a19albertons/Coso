  m_TableData:
  - m_Id: 11747233792
    m_Localized: "Hola, Cosa. \xBFQu\xE9 tal est\xE1s?"
    m_Metadata:
      m_Items: []
  - m_Id: 14989430784
    m_Localized: Yo, muy bien, veo que has terminado las pruebas.
    m_Metadata:
      m_Items: []
  - m_Id: 17434710016
    m_Localized: "\xBFPuedes avanzar un bloque?"
    m_Metadata:
      m_Items: []
  - m_Id: 19531862016
    m_Localized: "S\xED, pero mejor avanzo dos bloques."
    m_Metadata:
      m_Items: []
  - m_Id: 22132330496
    m_Localized: He visto la roca.
    m_Metadata:
      m_Items: []
  - m_Id: 24598581248
    m_Localized: Veo que has aprendido y no has tenido que repetir ninguna prueba.
    m_Metadata:
      m_Items: []
  - m_Id: 29690466304
    m_Localized: "Vamos en esta dirreci\xF3n para hablar de todos los preparativos
      de la boda."
    m_Metadata:
      m_Items: []
  references:
    version: 2

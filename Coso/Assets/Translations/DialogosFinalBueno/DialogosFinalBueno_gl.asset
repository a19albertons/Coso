  m_TableData:
  - m_Id: 11747233792
    m_Localized: "Ola, Cosa. Que tal est\xE1s?"
    m_Metadata:
      m_Items: []
  - m_Id: 14989430784
    m_Localized: Eu, moi ben,  vexo que terminastes as probas.
    m_Metadata:
      m_Items: []
  - m_Id: 17434710016
    m_Localized: Podes avanzar un bloque?
    m_Metadata:
      m_Items: []
  - m_Id: 19531862016
    m_Localized: Si, pero mellor avanzo dous bloques.
    m_Metadata:
      m_Items: []
  - m_Id: 22132330496
    m_Localized: Vin a roca.
    m_Metadata:
      m_Items: []
  - m_Id: 24598581248
    m_Localized: Vexo que aprendestes  e non tuvestes que repetir ningunha proba.
    m_Metadata:
      m_Items: []
  - m_Id: 29690466304
    m_Localized: "Vamos en esta dirreci\xF3n para falar de todos os preparativos
      da boda."
    m_Metadata:
      m_Items: []
